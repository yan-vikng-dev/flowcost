{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flowcost-webapp",
	"compatibility_date": "2025-11-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_private_origin"],
	"main": "./src/server.ts",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"placement": {
		"mode": "smart"
	},
	"vars": {
		"POSTHOG_HOST": "https://eu.i.posthog.com",
		"VITE_GTAG_ID": "AW-17572813812",
		"VITE_POSTHOG_KEY": "phc_h0VnQKH9G4gf7a1qTVSriK4zcQHp9BXmYQElEz6cYD4"
	},
	"routes": [
		{
			"pattern": "flowcost.co",
			"custom_domain": true
		}
	]
}
