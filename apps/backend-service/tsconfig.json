{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2024"],
		"jsx": "react-jsx",

		"noEmit": true,
		"baseUrl": ".",
		"types": ["./worker-configuration.d.ts", "./service-bindings.d.ts"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"exclude": ["test"],
	"include": [
		"worker-configuration.d.ts",
		"service-bindings.d.ts",
		"src/**/*.ts"
	]
}
