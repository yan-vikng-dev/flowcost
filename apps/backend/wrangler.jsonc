{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "flowcost-backend",
	"main": "./src/index.ts",
	"compatibility_date": "2025-11-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_private_origin"],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 0 * * *"]
	},
	"placement": {
		"mode": "smart",
	},
	"vars": {
		"POSTHOG_HOST": "https://eu.i.posthog.com",
		"POSTHOG_KEY": "phc_h0VnQKH9G4gf7a1qTVSriK4zcQHp9BXmYQElEz6cYD4",
		"WHATSAPP_PHONE_NUMBER_ID": "829846823540387"
	},
	"routes": [
		{
			"pattern": "backend.flowcost.co",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"remote": true,
			"binding": "DB",
			"database_name": "flowcost-db",
			"database_id": "e2dc49b0-3d97-4ada-9135-0a0c1410f54c"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "f52e1d3b9f2c4428a3b0f10a663cb5a7",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "AI_CONVERSATION_SERVER",
				"class_name": "AgentServer"
			},
			{
				"name": "NOTIFICATION_SCHEDULER",
				"class_name": "NotificationScheduler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AgentServer"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["NotificationScheduler"]
		}
	]
}
