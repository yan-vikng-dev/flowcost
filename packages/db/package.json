{
	"name": "@repo/db",
	"version": "1.0.0",
	"description": "Drizzle schemas and query helpers for Flowcost D1",
	"exports": {
		"./database/*": {
			"types": "./dist/database/*.d.ts",
			"default": "./dist/database/*.js"
		},
		"./drizzle/*": {
			"types": "./dist/drizzle/*.d.ts",
			"default": "./dist/drizzle/*.js"
		},
		"./drizzle/queries": {
			"types": "./dist/drizzle/queries/index.d.ts",
			"default": "./dist/drizzle/queries/index.js"
		},
		"./drizzle/queries/*": {
			"types": "./dist/drizzle/queries/*.d.ts",
			"default": "./dist/drizzle/queries/*.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate --config ./drizzle-kit.config.ts",
		"db:migrate": "drizzle-kit migrate --config ./drizzle-kit.config.ts",
		"db:pull": "drizzle-kit pull --config ./drizzle-kit.config.ts",
		"db:studio": "drizzle-kit studio --config ./drizzle-kit.config.ts",
		"db:push": "drizzle-kit push --config ./drizzle-kit.config.ts",
		"backfill:date-only": "node ./scripts/backfill-date-only.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.14.0",
	"dependencies": {
		"@neondatabase/serverless": "^1.0.2",
		"@planetscale/database": "^1.19.0",
		"@repo/shared-lib": "workspace:^",
		"drizzle-orm": "0.45.1",
		"luxon": "^3.7.2",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251107.0",
		"@types/luxon": "^3.7.1",
		"drizzle-kit": "0.31.8",
		"jiti": "^2.6.1",
		"mysql2": "^3.15.3",
		"postgres": "^3.4.7",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
