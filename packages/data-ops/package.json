{
  "name": "@repo/data-ops",
  "version": "1.0.0",
  "description": "Manage auth, database, schemas, and queries",
  "exports": {
    "./auth/*": {
      "default": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./database/*": {
      "default": "./dist/database/*.js",
      "types": "./dist/database/*.d.ts"
    },
    "./zod-schema/*": {
      "default": "./dist/zod-schema/*.js",
      "types": "./dist/zod-schema/*.d.ts"
    },
    "./queries/*": {
      "default": "./dist/queries/*.js",
      "types": "./dist/queries/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "better-auth:generate": "mkdir -p src/drizzle && npx @better-auth/cli@latest generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@repo/shared-config": "workspace:^",
    "@neondatabase/serverless": "^1.0.2",
    "@planetscale/database": "^1.19.0",
    "@polar-sh/better-auth": "^1.1.9",
    "@polar-sh/sdk": "^0.35.4",
    "better-auth": "^1.3.27",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite#": "link:@types/better-sqlite#",
    "drizzle-kit": "^0.31.5",
    "mysql2": "^3.15.2",
    "postgres": "^3.4.7",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
