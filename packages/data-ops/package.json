{
	"name": "@repo/data-ops",
	"version": "1.0.0",
	"description": "Manage auth, database, schemas, and queries",
	"exports": {
		"./auth/*": {
			"types": "./dist/auth/*.d.ts",
			"default": "./dist/auth/*.js"
		},
		"./database/*": {
			"types": "./dist/database/*.d.ts",
			"default": "./dist/database/*.js"
		},
		"./drizzle/*": {
			"types": "./dist/drizzle/*.d.ts",
			"default": "./dist/drizzle/*.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
		"typecheck": "tsc --noEmit",
		"better-auth:generate": "mkdir -p src/drizzle && npx @better-auth/cli@latest generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts",
		"drizzle:generate": "drizzle-kit generate --config ./drizzle-kit.config.ts",
		"drizzle:migrate": "drizzle-kit migrate --config ./drizzle-kit.config.ts",
		"drizzle:pull": "drizzle-kit pull --config ./drizzle-kit.config.ts",
		"drizzle:studio": "drizzle-kit studio --config ./drizzle-kit.config.ts",
		"drizzle:push": "drizzle-kit push --config ./drizzle-kit.config.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.14.0",
	"dependencies": {
		"@repo/shared-config": "workspace:^",
		"@neondatabase/serverless": "^1.0.2",
		"@planetscale/database": "^1.19.0",
		"@polar-sh/better-auth": "^1.1.9",
		"@polar-sh/sdk": "^0.35.4",
		"better-auth": "^1.3.27",
		"drizzle-orm": "^0.44.6",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251011.0",
		"drizzle-kit": "^0.31.5",
		"mysql2": "^3.15.2",
		"postgres": "^3.4.7",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.3"
	}
}
