{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"CLOUDFLARE_ACCOUNT_ID",
		"CLOUDFLARE_DATABASE_ID",
		"CLOUDFLARE_D1_TOKEN"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"deploy": {
			"dependsOn": ["build"],
			"cache": false
		},
		"cf:types": {
			"dependsOn": ["build"],
			"outputs": []
		}
	}
}
