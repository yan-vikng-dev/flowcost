{
	"name": "flowcost",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"dep": "turbo run deploy",
		"dev": "pnpm run --filter webapp dev",
		"studio": "pnpm run --filter data-ops drizzle:studio",
		"check": "pnpm exec biome check --write --max-diagnostics 10 --unsafe && turbo typecheck"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.19.0",
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@types/node": "^24.9.2",
		"globals": "^16.4.0",
		"turbo": "latest",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"drizzle-kit": "^0.31.6"
	},
	"pnpm": {
		"overrides": {
			"zod": "^4.1.12"
		},
		"peerDependencyRules": {
			"ignoreMissing": [
				"@vitest/runner",
				"@vitest/snapshot"
			],
			"allowedVersions": {
				"vitest": "4",
				"@vitest/runner": "4",
				"@vitest/snapshot": "4"
			}
		}
	}
}
