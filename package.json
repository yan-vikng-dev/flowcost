{
  "name": "saas-kit",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "setup": "pnpm i && pnpm run build:data-ops",
    "build:data-ops": "pnpm run --filter data-ops build",
    "build": "turbo run build",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "dev:webapp": "pnpm run --filter webapp dev",
    "deploy:webapp": "pnpm run build:data-ops && pnpm run --filter webapp deploy",
    "dev:data-service": "pnpm run --filter data-service dev",
    "deploy:data-service": "pnpm run build:data-ops && pnpm run --filter data-service deploy"
  },
